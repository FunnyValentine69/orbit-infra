{
  "schema_version": 1,
  "case_id": "case:aws_iam_policy.deployer_data:LogsCreateWithTag:ALL:aws:RequestTag/Project:non-matching",
  "document": "aws_iam_policy.deployer_data",
  "sid": "LogsCreateWithTag",
  "simulation_mode": "custom-isolated",
  "assertion_kind": "decision",
  "isolated_statement": {
    "Sid": "LogsCreateWithTag",
    "Effect": "Allow",
    "Action": ["logs:CreateLogGroup", "logs:TagResource"],
    "Resource": "arn:aws:logs:*:${ACCOUNT_ID}:log-group:/orbit/${SUFFIX}/*",
    "Condition": {
      "StringEquals": {
        "aws:RequestTag/Project": "orbit-infra"
      }
    }
  },
  "action_names": ["logs:CreateLogGroup", "logs:TagResource"],
  "resource_arns": [
    "arn:aws:logs:us-east-1:${ACCOUNT_ID}:log-group:/orbit/${SUFFIX}/example"
  ],
  "context_entries": [
    {
      "ContextKeyName": "aws:RequestTag/Project",
      "ContextKeyValues": ["not-orbit-infra"],
      "ContextKeyType": "string"
    }
  ],
  "expect": {
    "decision": "implicitDeny",
    "matched_sid_required": [],
    "matched_sid_forbidden": []
  }
}
