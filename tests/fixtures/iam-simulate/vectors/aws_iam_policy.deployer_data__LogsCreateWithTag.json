{
  "schema_version": 1,
  "document": "aws_iam_policy.deployer_data",
  "sid": "LogsCreateWithTag",
  "cases": [
    {
      "case_id": "case:aws_iam_policy.deployer_data:LogsCreateWithTag:ALL:aws:RequestTag/Project:absent",
      "simulation_mode": "custom-isolated",
      "assertion_kind": "decision",
      "action_names": ["logs:CreateLogGroup","logs:TagResource"],
      "resource_arns": ["arn:aws:logs:us-east-1:${ACCOUNT_ID}:log-group:/orbit/preview"],
      "context_entries": [],
      "expect": {"decision":"implicitDeny","matched_sid_required":[],"matched_sid_forbidden":["LogsCreateWithTag"]}
    },
    {
      "case_id": "case:aws_iam_policy.deployer_data:LogsCreateWithTag:ALL:aws:RequestTag/Project:matching",
      "simulation_mode": "custom",
      "assertion_kind": "decision",
      "action_names": ["logs:CreateLogGroup","logs:TagResource"],
      "resource_arns": ["arn:aws:logs:us-east-1:${ACCOUNT_ID}:log-group:/orbit/preview"],
      "context_entries": [{"ContextKeyName":"aws:RequestTag/Project","ContextKeyValues":["orbit-infra"],"ContextKeyType":"string"}],
      "expect": {"decision":"allowed","matched_sid_required":["LogsCreateWithTag"],"matched_sid_forbidden":[]}
    },
    {
      "case_id": "case:aws_iam_policy.deployer_data:LogsCreateWithTag:ALL:aws:RequestTag/Project:non-matching",
      "simulation_mode": "custom-isolated",
      "assertion_kind": "decision",
      "action_names": ["logs:CreateLogGroup","logs:TagResource"],
      "resource_arns": ["arn:aws:logs:us-east-1:${ACCOUNT_ID}:log-group:/orbit/preview"],
      "context_entries": [{"ContextKeyName":"aws:RequestTag/Project","ContextKeyValues":["other-project"],"ContextKeyType":"string"}],
      "expect": {"decision":"implicitDeny","matched_sid_required":[],"matched_sid_forbidden":["LogsCreateWithTag"]}
    },
    {
      "case_id": "case:aws_iam_policy.deployer_data:LogsCreateWithTag:ALL:resource:nonmatching",
      "simulation_mode": "custom-isolated",
      "assertion_kind": "decision",
      "action_names": ["logs:CreateLogGroup","logs:TagResource"],
      "resource_arns": ["arn:aws:logs:us-east-1:${ACCOUNT_ID}:log-group:/outside/${SUFFIX}/example"],
      "context_entries": [{"ContextKeyName":"aws:RequestTag/Project","ContextKeyValues":["orbit-infra"],"ContextKeyType":"string"}],
      "expect": {"decision":"implicitDeny","matched_sid_required":[],"matched_sid_forbidden":["LogsCreateWithTag"]}
    }
  ]
}
