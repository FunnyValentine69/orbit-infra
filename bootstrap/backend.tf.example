# Copy this file to backend.tf AFTER the first local-state apply on real AWS,
# then run: terraform -chdir=bootstrap init -migrate-state
# (LocalStack runs never use this file; see localstack.backend_override.tf.example.)

terraform {
  backend "s3" {
    bucket       = "orbit-infra-79s5rw-tfstate"
    key          = "bootstrap/terraform.tfstate"
    region       = "us-east-1"
    use_lockfile = true
    encrypt      = true
  }
}
